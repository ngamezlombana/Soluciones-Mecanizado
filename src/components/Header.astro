---
import { consultoriaData } from '../data/consultoria';
---

<header class="fixed top-0 left-0 right-0 w-full z-50 bg-surface-container-lowest border-b border-surface-variant transition-all">
  <div class="h-16 w-full max-w-7xl mx-auto px-margin-mobile md:px-margin flex items-center justify-between">
    <!-- Logotipo y Nombre Técnico -->
    <a href="/" class="flex items-center gap-space-sm group focus:outline-none">
      <div class="w-9 h-9 bg-surface-container-high border border-outline-variant flex items-center justify-center text-primary-container font-display font-bold text-lg group-hover:border-primary-container transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="8"/>
          <path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>
          <circle cx="12" cy="12" r="2" fill="currentColor"/>
        </svg>
      </div>
      <div class="flex flex-col border-l border-outline-variant pl-space-sm">
        <span class="font-display font-bold text-sm md:text-base uppercase tracking-wider text-on-surface leading-tight">
          {consultoriaData.nombreEmpresa}
        </span>
        <span class="font-display font-semibold text-[11px] uppercase tracking-widest text-secondary leading-none">
          {consultoriaData.consultor.nombre}
        </span>
      </div>
    </a>

    <!-- Navegación Escritorio -->
    <nav class="hidden lg:flex items-center gap-space-lg font-display font-semibold text-sm uppercase tracking-wider text-secondary">
      <a href="#servicios" class="hover:text-primary-container transition-colors py-1">Servicios</a>
      <a href="#como-trabajamos" class="hover:text-primary-container transition-colors py-1">Metodología</a>
      <a href="#opiniones" class="hover:text-primary-container transition-colors py-1">Casos de Éxito</a>
      <a href="#cotizador" class="hover:text-primary-container transition-colors py-1">Diagnóstico</a>
      <a href="#cobertura" class="hover:text-primary-container transition-colors py-1">Cobertura</a>
      <a href="#faqs" class="hover:text-primary-container transition-colors py-1">Preguntas</a>
    </nav>

    <!-- CTAs Directos -->
    <div class="flex items-center gap-space-md">
      <!-- Teléfono Directo -->
      <a 
        href={`tel:${consultoriaData.contacto.telefonoRaw}`} 
        class="hidden md:flex items-center gap-1.5 text-secondary hover:text-primary-container transition-colors font-display font-semibold text-sm uppercase tracking-wider"
      >
        <svg class="w-4 h-4 text-primary-container" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>{consultoriaData.contacto.telefonoDisplay}</span>
      </a>

      <!-- Botón WhatsApp -->
      <a 
        href={`https://wa.me/${consultoriaData.contacto.whatsappRaw}?text=${encodeURIComponent(consultoriaData.contacto.whatsappTextoDefault)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 bg-primary-container text-surface-container-lowest font-display font-bold text-xs md:text-sm uppercase tracking-wider px-space-md py-2 hover:bg-on-surface hover:text-surface-container-lowest transition-colors"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
        <span>Cotizar Asesoría</span>
      </a>
    </div>
  </div>
</header>
