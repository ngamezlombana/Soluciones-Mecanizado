---
import { consultoriaData } from '../data/consultoria';
---

<section class="w-full bg-surface-container-lowest py-space-xl border-b border-surface-variant" id="cobertura">
  <div class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin space-y-space-lg">
    <div>
      <span class="font-display font-semibold text-xs uppercase tracking-widest text-primary-container flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 bg-primary-container"></span>
        COBERTURA Y CONTACTO
      </span>
      <h2 class="font-display font-bold text-2xl sm:text-4xl uppercase text-on-surface tracking-wide mt-1">
        INGENIERÍA Y CONSULTORÍA TÉCNICA EN CALI Y VALLE DEL CAUCA
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-stretch">
      <!-- Columna Información de Cobertura (5 cols) -->
      <div class="lg:col-span-5 bg-surface-container p-space-lg flex flex-col justify-between space-y-space-md border border-surface-variant">
        <div class="space-y-space-sm">
          <div class="flex items-center justify-between text-xs font-display font-semibold text-secondary">
            <span>SEDE PROFESIONAL:</span>
            <span class="text-primary-container font-bold">[CALI · YUMBO · REMOTO]</span>
          </div>

          <h3 class="font-display font-bold text-xl uppercase text-on-surface">
            {consultoriaData.consultor.nombre}
          </h3>

          <div class="space-y-space-xs font-body text-sm text-secondary pt-2">
            <div class="flex items-start gap-2.5">
              <span class="w-2.5 h-2.5 bg-primary-container shrink-0 mt-1"></span>
              <div>
                <strong class="text-on-surface block font-semibold">Atención Presencial en Planta</strong>
                <span class="text-xs">{consultoriaData.ubicacion.zonasPresenciales.join(', ')}.</span>
              </div>
            </div>

            <div class="flex items-start gap-2.5 pt-2">
              <span class="w-2.5 h-2.5 bg-secondary shrink-0 mt-1"></span>
              <div>
                <strong class="text-on-surface block font-semibold">Consultoría y Programación Remota</strong>
                <span class="text-xs">{consultoriaData.ubicacion.coberturaRemota}.</span>
              </div>
            </div>
          </div>

          <!-- Horarios -->
          <div class="bg-surface-container-lowest p-space-sm space-y-1.5 font-body text-xs border border-surface-variant/40 mt-3">
            <span class="font-display font-bold text-[11px] uppercase text-primary-container block tracking-wider">
              HORARIOS DE ATENCIÓN:
            </span>
            <div class="flex justify-between text-secondary">
              <span>Lunes a Viernes:</span>
              <span class="text-on-surface font-semibold">{consultoriaData.horario.diasSemana}</span>
            </div>
            <div class="flex justify-between text-secondary">
              <span>Sábados:</span>
              <span class="text-on-surface font-semibold">{consultoriaData.horario.sabados}</span>
            </div>
            <div class="flex justify-between text-secondary pt-1 border-t border-surface-variant/40">
              <span>Teléfono directo:</span>
              <a href={`tel:${consultoriaData.contacto.telefonoRaw}`} class="text-primary-container font-bold hover:underline">
                {consultoriaData.contacto.telefonoDisplay}
              </a>
            </div>
          </div>
        </div>

        <div class="pt-space-sm space-y-2">
          <a 
            href={`https://wa.me/${consultoriaData.contacto.whatsappRaw}?text=${encodeURIComponent("Hola Ing. Nestor, deseo coordinar una visita técnica o reunión de asesoría.")}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full bg-primary-container text-surface-container-lowest font-display font-bold text-xs uppercase tracking-wider py-3 px-4 flex items-center justify-center gap-2 hover:bg-on-surface transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>COORDINAR ASESORÍA POR WHATSAPP</span>
          </a>

          <a 
            href={`tel:${consultoriaData.contacto.telefonoRaw}`}
            class="w-full bg-surface-container-highest text-on-surface font-display font-bold text-xs uppercase tracking-wider py-3 px-4 flex items-center justify-center gap-2 hover:bg-surface-bright transition-colors border border-surface-variant"
          >
            <span>LLAMAR DIRECTAMENTE ({consultoriaData.contacto.telefonoDisplay})</span>
          </a>
        </div>
      </div>

      <!-- Columna Mapa Interactivo On-Demand (7 cols) -->
      <div class="lg:col-span-7 bg-surface-container-low min-h-[360px] relative overflow-hidden flex flex-col justify-between border border-surface-variant" id="mapContainer">
        <!-- Imagen fija optimizada con botón de carga bajo demanda para cero impacto en PageSpeed -->
        <div 
          id="mapImageCover"
          class="w-full h-full min-h-[380px] relative bg-cover bg-center cursor-pointer group"
          style="background-image: url('/fotos/mapa-industrial-cali.webp');"
          onclick="loadInteractiveMap()"
        >
          <div class="absolute inset-0 bg-surface/60 group-hover:bg-surface/40 transition-colors flex flex-col items-center justify-center p-6 text-center">
            <div class="w-12 h-12 bg-primary-container text-surface-container-lowest flex items-center justify-center mb-3">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <span class="font-display font-bold text-base uppercase text-on-surface block tracking-wide">
              ZONA INDUSTRIAL CALI - YUMBO
            </span>
            <span class="font-body text-xs text-secondary mt-1 max-w-sm">
              Haz clic aquí para cargar el mapa interactivo de Google Maps enfocado en plantas industriales
            </span>
            <button 
              type="button" 
              class="mt-3 bg-surface-container-high text-primary-container px-4 py-2 font-display font-bold text-xs uppercase tracking-wider border border-primary-container hover:bg-primary-container hover:text-surface-container-lowest transition-colors"
            >
              CARGAR GOOGLE MAPS
            </button>
          </div>
        </div>

        <!-- Contenedor del Iframe cargado dinámicamente -->
        <div id="interactiveMapIframe" class="hidden w-full h-full min-h-[380px]"></div>

        <div class="w-full bg-surface-container-lowest/95 px-space-md py-2 flex flex-wrap items-center justify-between font-display font-semibold text-[11px] text-secondary border-t border-surface-variant">
          <span>SECTOR INDUSTRIAL VALLE DEL CAUCA &amp; CONSULTORÍA REMOTA</span>
          <span class="text-primary-container font-mono">CALI · VALLE DEL CAUCA · COLOMBIA</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script de carga bajo demanda del mapa -->
<script is:inline>
  function loadInteractiveMap() {
    const cover = document.getElementById('mapImageCover');
    const iframeBox = document.getElementById('interactiveMapIframe');
    if (!cover || !iframeBox) return;

    cover.classList.add('hidden');
    iframeBox.classList.remove('hidden');
    
    // Inserción segura del iframe con enfoque en Cali / Yumbo
    iframeBox.innerHTML = `
      <iframe 
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d63688.19792617637!2d-76.5458992!3d3.4795325!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e30a6f0cc4f933f%3A0x7d6a5c1a7d6e6f9d!2sYumbo%2C%20Valle%20del%20Cauca%2C%20Colombia!5e0!3m2!1ses!2sco!4v1700000000000!5m2!1ses!2sco" 
        width="100%" 
        height="100%" 
        style="border:0; min-height: 380px;" 
        allowfullscreen="" 
        loading="lazy" 
        referrerpolicy="no-referrer-when-downgrade"
        title="Mapa de cobertura industrial Cali y Yumbo"
      ></iframe>
    `;
  }
</script>
