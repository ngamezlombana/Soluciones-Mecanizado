---
import { consultoriaData } from '../data/consultoria';
---

<section class="w-full bg-surface relative bg-grid-cartesian border-b border-surface-variant">
  <div class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin py-8 md:py-14">
    
    <!-- Meta telemetry banner -->
    <div class="flex flex-wrap items-center justify-between gap-space-sm pb-space-md text-[11px] md:text-xs font-display font-semibold text-secondary border-b border-surface-variant/40 mb-8">
      <div class="flex items-center gap-2">
        <span class="text-primary-container">ESPECIALISTA INDEPENDIENTE:</span>
        <span class="text-on-surface uppercase font-bold">{consultoriaData.consultor.nombre}</span>
        <span class="text-outline-variant">|</span>
        <span class="text-secondary uppercase">CALI - VALLE DEL CAUCA</span>
      </div>

      <!-- Live Business Hour Status Indicator (calculated client-side with America/Bogota) -->
      <div class="flex items-center gap-3" id="liveStatusContainer">
        <span class="flex items-center gap-1.5 text-primary-container font-bold" id="statusBadge">
          <span class="w-2 h-2 bg-primary-container animate-ping inline-block" id="statusPulse"></span>
          <span id="statusText">CONSULTORÍA DISPONIBLE</span>
        </span>
        <span class="text-on-surface">{consultoriaData.horario.diasSemana}</span>
      </div>
    </div>

    <!-- Hero Grid 12 cols -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-lg items-start">
      <!-- Columna Izquierda: Información Principal -->
      <div class="lg:col-span-7 space-y-space-md">
        <div class="inline-flex items-center gap-2 bg-surface-container-high px-space-sm py-1 border-l-2 border-primary-container">
          <svg class="w-4 h-4 text-primary-container" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span class="font-display font-semibold text-xs uppercase tracking-widest text-on-surface">
            {consultoriaData.consultor.titulo}
          </span>
        </div>

        <h1 class="font-display font-bold text-3xl sm:text-5xl lg:text-[54px] uppercase text-on-surface tracking-wide leading-[1.08]">
          ASESORÍA Y CONSULTORÍA EN INGENIERÍA <span class="bg-primary-container text-surface-container-lowest px-2 inline-block">CAD/CAM Y MECANIZADO CNC</span>
        </h1>

        <p class="font-body text-base md:text-lg text-secondary max-w-2xl leading-relaxed">
          {consultoriaData.consultor.nombre} · Consultor en Cali, Valle del Cauca. {consultoriaData.consultor.experiencia} optimizando procesos de fabricación, diseño técnico y mecanizado de alta precisión con <strong class="text-on-surface font-semibold">SolidWorks, Mastercam, AutoCAD y BobCAD-CAM</strong>.
        </p>

        <!-- Botones de Acción -->
        <div class="pt-2 flex flex-col sm:flex-row gap-space-sm">
          <a 
            href={`https://wa.me/${consultoriaData.contacto.whatsappRaw}?text=${encodeURIComponent(consultoriaData.contacto.whatsappTextoDefault)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-primary-container text-surface-container-lowest font-display font-bold text-sm uppercase tracking-wider px-6 py-3.5 hover:bg-on-surface hover:text-surface-container-lowest transition-colors shadow-none"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>CONSULTAR POR WHATSAPP (Respuesta &lt;15 min)</span>
          </a>

          <a 
            href={`tel:${consultoriaData.contacto.telefonoRaw}`}
            class="inline-flex items-center justify-center gap-2 bg-surface-container text-on-surface font-display font-bold text-sm uppercase tracking-wider px-6 py-3.5 hover:bg-surface-container-high transition-colors border border-surface-variant"
          >
            <svg class="w-4 h-4 text-primary-container" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>LLAMAR AHORA: {consultoriaData.contacto.telefonoDisplay}</span>
          </a>
        </div>

        <!-- Badges de Confianza -->
        <div class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-space-sm">
          <div class="bg-surface-container-low p-space-sm flex items-center gap-space-sm border border-surface-variant">
            <div class="text-primary-container text-xl leading-none">★★★★★</div>
            <div class="font-display font-semibold text-xs leading-tight">
              <span class="text-on-surface block font-bold uppercase">5.0 REPUTACIÓN PROFESIONAL</span>
              <span class="text-secondary font-body">Empresas y talleres industriales en el Valle</span>
            </div>
          </div>
          <div class="bg-surface-container-low p-space-sm flex items-center gap-space-sm border border-surface-variant">
            <span class="w-3 h-3 bg-primary-container inline-block"></span>
            <div class="font-display font-semibold text-xs leading-tight">
              <span class="text-on-surface block font-bold uppercase">ATENCIÓN TÉCNICA ACTIVA</span>
              <span class="text-secondary font-body">Visitas en planta y asesoría remota</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Tarjeta Fotográfica & CAD Callout -->
      <div class="lg:col-span-5 space-y-space-sm">
        <div class="relative bg-surface-container-lowest border border-surface-variant overflow-hidden">
          <div class="w-full bg-surface-container-high px-space-sm py-1.5 flex justify-between items-center font-display font-semibold text-[11px] text-secondary border-b border-surface-variant">
            <span>|--- CAD: SOLIDWORKS ---|</span>
            <span class="text-primary-container">MASTERCAM CAM</span>
            <span>|--- AUTOCAD 2D/3D ---|</span>
          </div>

          <!-- Imagen Optimizada de Taller CNC -->
          <div class="relative h-72 sm:h-80 w-full bg-surface-container-low">
            <img 
              src="/fotos/taller-cnc-cali.webp" 
              alt="Mecanizado CNC y programación CAD/CAM en Cali"
              class="w-full h-full object-cover"
              width="640"
              height="360"
              loading="eager"
            />
            <div class="absolute top-3 left-3 bg-surface-container-lowest/90 px-2.5 py-1 font-display font-semibold text-xs text-primary-container border border-surface-variant">
              Mastercam &amp; BobCAD-CAM
            </div>
            <div class="absolute bottom-10 right-3 bg-surface-container-lowest/90 px-2.5 py-1 font-display font-semibold text-xs text-on-surface border border-surface-variant flex items-center gap-1.5">
              <span class="w-2 h-2 bg-primary-container inline-block"></span>
              <span>Simulación sin colisiones</span>
            </div>
            <div class="absolute bottom-2 left-3 bg-surface-container-high/90 px-2 py-0.5 font-display font-semibold text-[11px] text-secondary">
              CALI · YUMBO · SOPORTE REMOTO
            </div>
          </div>
        </div>

        <!-- Callout de archivo / diagnóstico -->
        <div class="bg-surface-container p-space-md space-y-2 border border-surface-variant">
          <div class="flex items-center justify-between text-xs font-display font-semibold">
            <span class="text-primary-container uppercase font-bold flex items-center gap-1.5">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              EVALUACIÓN DE PLANOS Y CÓDIGO G
            </span>
            <span class="text-secondary font-mono">.SLDPRT .STEP .MCX .DXF</span>
          </div>
          <p class="font-body text-xs text-secondary leading-normal">
            ¿Tienes un requerimiento de diseño o necesitas programar piezas en máquina? Envía tus archivos para un diagnóstico técnico sin costo.
          </p>
          <a 
            href="#cotizador" 
            class="w-full bg-surface-container-highest text-on-surface hover:bg-primary-container hover:text-surface-container-lowest transition-colors py-2.5 px-3 font-display font-bold text-xs uppercase tracking-wider flex items-center justify-between border border-surface-variant"
          >
            <span>SOLICITAR ASESORÍA TÉCNICA</span>
            <span>↓</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script de cálculo de horario comercial en tiempo real con America/Bogota -->
<script is:inline>
  function updateBusinessStatus() {
    try {
      const options = { timeZone: 'America/Bogota', hour: 'numeric', minute: 'numeric', weekday: 'short', hour12: false };
      const formatter = new Intl.DateTimeFormat([], options);
      const parts = formatter.formatToParts(new Date());
      let hour = 0;
      let weekday = '';
      
      for (const part of parts) {
        if (part.type === 'hour') hour = parseInt(part.value, 10);
        if (part.type === 'weekday') weekday = part.value.toLowerCase();
      }

      const isWeekday = !weekday.startsWith('sáb') && !weekday.startsWith('sat') && !weekday.startsWith('dom') && !weekday.startsWith('sun');
      const isSaturday = weekday.startsWith('sáb') || weekday.startsWith('sat');

      let isOpen = false;
      if (isWeekday && hour >= 8 && hour < 18) {
        isOpen = true;
      } else if (isSaturday && hour >= 8 && hour < 13) {
        isOpen = true;
      }

      const statusText = document.getElementById('statusText');
      const statusBadge = document.getElementById('statusBadge');
      const statusPulse = document.getElementById('statusPulse');

      if (statusText && statusBadge && statusPulse) {
        if (isOpen) {
          statusText.textContent = 'CONSULTORÍA DISPONIBLE';
          statusBadge.className = 'flex items-center gap-1.5 text-primary-container font-bold';
          statusPulse.className = 'w-2 h-2 bg-primary-container animate-ping inline-block';
        } else {
          statusText.textContent = 'FUERA DE HORARIO (ATENCIÓN ACTIVA VÍA WHATSAPP)';
          statusBadge.className = 'flex items-center gap-1.5 text-secondary font-semibold';
          statusPulse.className = 'w-2 h-2 bg-secondary inline-block';
        }
      }
    } catch (e) {
      console.log('Timezone calculation fallback', e);
    }
  }
  updateBusinessStatus();
</script>
