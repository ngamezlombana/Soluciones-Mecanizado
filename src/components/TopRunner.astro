---
import { consultoriaData } from '../data/consultoria';
---

<div class="w-full bg-surface-container-lowest border-b border-surface-variant flex items-center justify-between px-margin-mobile md:px-margin py-2 text-[11px] md:text-xs font-display font-semibold tracking-widest uppercase">
  <div class="flex items-center gap-3 overflow-hidden text-ellipsis whitespace-nowrap">
    <span class="w-2.5 h-2.5 bg-primary-container inline-block shrink-0"></span>
    <span class="text-on-surface">CONSULTORÍA &amp; INGENIERÍA CAD/CAM // CALI, CO</span>
    <span class="hidden md:inline text-secondary">[SOLIDWORKS · MASTERCAM · AUTOCAD · BOBCAD-CAM]</span>
  </div>
  <div class="hidden sm:flex items-center gap-4 shrink-0">
    <span class="text-secondary">SUPERVISIÓN Y DFM</span>
    <span class="bg-surface-variant text-primary-container px-2 py-0.5">OPTIMIZACIÓN G-CODE &amp; PROCESOS CNC</span>
  </div>
</div>
