---
import { consultoriaData } from '../data/consultoria';
---

<section class="w-full bg-surface-container-lowest py-space-xl border-b border-surface-variant" id="como-trabajamos">
  <div class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin space-y-space-lg">
    <div>
      <span class="font-display font-semibold text-xs uppercase tracking-widest text-primary-container flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 bg-primary-container"></span>
        METODOLOGÍA DE INGENIERÍA
      </span>
      <h2 class="font-display font-bold text-2xl sm:text-4xl uppercase text-on-surface tracking-wide mt-1">
        CÓMO TRABAJAMOS: PROTOCOLO DE ASESORÍA EN 3 FASES
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
      {consultoriaData.metodologia.map((item) => (
        <div class="bg-surface-container-low p-space-lg relative flex flex-col justify-between border border-surface-variant hover:border-primary-container transition-colors group">
          <div>
            <div class="flex items-center justify-between pb-space-md">
              <span class="font-display font-bold text-5xl text-primary-container leading-none">{item.paso}</span>
              <div class="w-6 h-6 border border-outline-variant flex items-center justify-center text-secondary group-hover:text-primary-container group-hover:border-primary-container transition-colors font-mono text-xs">
                +
              </div>
            </div>
            <div class="text-[11px] font-display font-semibold text-secondary uppercase pb-1 tracking-wider">
              {item.etapa}
            </div>
            <h3 class="font-display font-bold text-xl uppercase text-on-surface mb-2">
              {item.titulo}
            </h3>
            <p class="font-body text-sm text-secondary leading-relaxed">
              {item.descripcion}
            </p>
          </div>
          <div class="mt-space-md pt-space-xs text-[11px] font-display font-semibold tracking-wider text-outline border-t border-surface-variant/50">
            {item.tag}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
