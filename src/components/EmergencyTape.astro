---
import { consultoriaData } from '../data/consultoria';
---

<section class="w-full bg-primary-container text-surface-container-lowest py-space-md border-b border-surface-variant">
  <div class="w-full max-w-7xl mx-auto px-margin-mobile md:px-margin flex flex-col md:flex-row items-center justify-between gap-space-md">
    <div class="flex items-center gap-space-sm text-center md:text-left">
      <div class="hidden sm:flex w-10 h-10 bg-surface-container-lowest text-primary-container items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <span class="font-display font-bold text-lg md:text-xl uppercase block leading-tight">
          ¿TIENES UNA URGENCIA EN PROGRAMACIÓN O DISEÑO?
        </span>
        <span class="font-body text-xs md:text-sm text-surface-container-lowest/80 font-medium">
          Soporte técnico prioritario en SolidWorks, Mastercam y depuración de código G para evitar paradas de producción.
        </span>
      </div>
    </div>
    
    <a 
      href={`https://wa.me/${consultoriaData.contacto.whatsappRaw}?text=${encodeURIComponent("URGENCIA TÉCNICA: Requiero asesoría inmediata en CAD/CAM o código G en máquina.")}`}
      target="_blank"
      rel="noopener noreferrer"
      class="bg-surface-container-lowest text-on-surface font-display font-bold text-xs md:text-sm uppercase tracking-wider px-space-lg py-3 hover:bg-surface hover:text-primary-container transition-colors whitespace-nowrap border border-surface-variant shrink-0"
    >
      CONSULTAR CON ING. NESTOR ({consultoriaData.contacto.telefonoDisplay})
    </a>
  </div>
</section>
